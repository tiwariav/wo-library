{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "cli": {
    "packageManager": "pnpm"
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": [
      "@wo-library/js",
      "@wo-library/web",
      "@wo-library/node",
      "@wo-library/eslint-config",
      "@wo-library/oxlint-config",
      "@wo-library/postcss-config",
      "@wo-library/stylelint-config",
      "@wo-library/semantic-release-config"
    ],
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk"
    },
    "changelog": {
      "automaticFromRef": "2a8df82f0e5471dd402aea0168390ca5370acf18",
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github",
        "file": "{projectRoot}/CHANGELOG.md",
        "renderOptions": {
          "authors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "git": {
      "commitMessage": "chore(release): publish {version}"
    },
    "releaseTag": {
      "pattern": "{projectName}@v{version}"
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "docs": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true
    },
    "storybook": {
      "cache": true
    },
    "build-storybook": {
      "cache": true,
      "dependsOn": ["^build"]
    }
  },
  "plugins": [],
  "affected": {
    "legacy": true
  }
}
