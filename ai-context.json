{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Machine-readable metadata for AI agents working in the wo-library monorepo.",
  "updated": "2026-11-17",
  "activePlan": "docs/plans/v3-plan.md",
  "packages": {
    "@wo-library/js": {
      "description": "Pure TypeScript utilities with no browser or React dependencies.",
      "importPath": "@wo-library/js",
      "categories": {
        "array": {
          "exports": ["range", "addOrUpdate"],
          "description": "Create numeric ranges; add-or-update items in arrays."
        },
        "number": {
          "exports": [
            "formatNumber",
            "formatNumberWhileTyping",
            "formatNumberWithSuffix",
            "ordinalNumber",
            "parseFormattedNumber",
            "stringToNumber"
          ],
          "description": "Number formatting using en-IN locale (Lakhs/Crores).",
          "warnings": ["Always use en-IN locale — do NOT change to en-US."]
        },
        "phone": {
          "exports": ["getFlagEmoji"],
          "description": "Country-code to flag emoji helper."
        },
        "progress": {
          "exports": [
            "ARC_ANGLE",
            "MAX_PROGRESS",
            "getArcSegmentAngles",
            "getCircleStyles",
            "getProgressClass",
            "getProgressTextContent"
          ],
          "description": "Geometry helpers for arc/circle progress indicators."
        },
        "objects": {
          "exports": ["pushOrCreate", "getNestedValue"],
          "description": "Object helpers."
        },
        "colors": {
          "exports": ["rgbToHex", "hexToRgb", "randomGradientGenerator"],
          "description": "Color conversion and gradients."
        },
        "svg": {
          "exports": [
            "polarToCartesian",
            "describeArc",
            "svgPathPinData",
            "svgPathFlagData"
          ],
          "description": "SVG arc geometry and icon path data."
        },
        "misc": {
          "exports": ["wait"],
          "description": "Promise-based delay helper."
        }
      }
    },
    "@wo-library/web": {
      "description": "Browser and DOM utilities for networking, storage, script loading, and uploads.",
      "importPath": "@wo-library/web",
      "categories": {
        "fetch": {
          "exports": ["WoFetch", "WoFetchBase"],
          "description": "Configurable HTTP client."
        },
        "storage": {
          "exports": ["AnyStorage", "anyStorageInstance"],
          "description": "localStorage/sessionStorage/memory abstraction."
        },
        "script-loading": {
          "exports": ["loadScript", "loadStylesheet"],
          "description": "Dynamically inject scripts and stylesheets."
        },
        "upload": {
          "exports": ["UploadFile", "UPLOAD_FILE_STATUS"],
          "description": "Client-side upload item with status tracking."
        },
        "css": {
          "exports": ["cssVariable", "overrideStyleProperty"],
          "description": "CSS custom property helpers."
        }
      }
    },
    "@wo-library/registry": {
      "description": "shadcn registry source (not published to npm). Hooks, lib helpers, themes, and future ui items.",
      "importPath": null,
      "path": "packages/registry",
      "contents": {
        "hooks": [
          "useMethods",
          "useStateWithProp",
          "usePropRef",
          "useScrollDirection",
          "useLocalStorage",
          "useCalendly"
        ],
        "lib": [
          "createAndUseContext",
          "getUpdateStateMethod",
          "useSimpleProvider"
        ],
        "themes": ["fresh", "trusty"],
        "ui": "added in phase 4"
      }
    }
  },
  "patterns": {
    "namedExportsOnly": "All public APIs use named exports. Never add default exports to public APIs.",
    "typescriptStrict": "TypeScript strict mode is enabled. Use 'unknown' instead of 'any'.",
    "indiaLocale": "Number formatting uses en-IN (Indian numbering system: Lakhs/Crores).",
    "registryUi": "UI is copied from packages/registry via shadcn; appearance is Tailwind 4 + base-ui. No CSS Modules package.",
    "lodashEs": "Always import from 'lodash-es', never from 'lodash'."
  },
  "testing": {
    "framework": "Jest with @jest/globals (Vitest in phase 1)",
    "location": "Test files go in __tests__/ subdirectories alongside source"
  },
  "buildSystem": {
    "bundler": "Rollup (tsdown in phase 1)",
    "output": "ESM only: dist/index.js + dist/index.d.ts"
  },
  "documentation": {
    "primaryHub": "Storybook (packages/storybook)",
    "storybook": {
      "host": "packages/storybook",
      "storiesGlobs": [
        "packages/registry/**/*.stories.@(js|jsx|ts|tsx|mdx)",
        "packages/web/src/**/*.stories.@(js|jsx|ts|tsx|mdx)"
      ]
    },
    "activePlan": "docs/plans/v3-plan.md"
  }
}
