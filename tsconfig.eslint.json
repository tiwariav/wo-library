{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "moduleResolution": "bundler",
    "rootDir": "."
  },
  "include": [
    "packages/js/src/**/*",
    "packages/js/*.config.ts",
    "packages/node/src/**/*",
    "packages/node/*.config.ts",
    "packages/postcss-config/**/*.d.ts",
    "packages/registry/hooks/**/*",
    "packages/registry/lib/**/*",
    "packages/registry/ui/**/*",
    "packages/storybook/.storybook/**/*.ts",
    "packages/web/src/**/*",
    "packages/web/*.config.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "tmp"]
}
