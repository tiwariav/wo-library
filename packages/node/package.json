{
  "name": "@wo-library/node",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Node.js utilities",
  "license": "MIT",
  "keywords": [
    "wo-library",
    "node",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tiwariav/wo-library.git",
    "directory": "packages/node"
  },
  "homepage": "https://github.com/tiwariav/wo-library/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/tiwariav/wo-library/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
