{
  "name": "@wo-library/web",
  "version": "2.1.2",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Web/DOM utilities",
  "license": "MIT",
  "keywords": [
    "wo-library",
    "web",
    "dom",
    "utilities"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tiwariav/wo-library.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/tiwariav/wo-library/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/tiwariav/wo-library/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "lodash-es": "^4.18.1",
    "type-fest": "^6.0.1"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-v8": "^5.1.0",
    "@wo-library/js": "workspace:^",
    "jsdom": "^28.1.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
